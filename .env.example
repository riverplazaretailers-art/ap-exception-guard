# AP Exception Desk — frontend environment
# Copy to .env.local and fill in per environment. Never commit real values.

# ---------------------------------------------------------------------------
# Mode selection (explicit, fail-closed)
#
#   demo         (default)  nothing set below. Visibly synthetic records only.
#   secure-link  VITE_SECURE_WORKSPACE_URL set. Sign-in, request-access,
#                connect and upload CTAs hand off to the preserved secure
#                AP Exception Desk workspace. This shell shows demo data only.
#   api          VITE_API_BASE_URL *and* VITE_API_CONTRACT_VERSION=v1 both set.
#                Typed gateway against the backend's real routes. If either is
#                missing or the version does not match, API mode stays OFF.
# ---------------------------------------------------------------------------

# Preserved secure workspace (its own sign-in; owns real accounts and sessions).
# Absolute https URL, no credentials, no query string.
# Example: https://app.apexceptiondesk.example
VITE_SECURE_WORKSPACE_URL=

# Backend gateway origin. Absolute https URL (http allowed only for localhost).
# Routes the backend actually exposes:
#   GET|POST /api/pilots
#   GET      /api/pilots/:id
#   POST     /api/pilots/:id/files            (multipart)
#   PATCH    /api/findings/:id
#   GET      /api/integrations/quickbooks/status?pilotId=
#   GET      /api/integrations/quickbooks/start?pilotId=
#   POST     /api/integrations/quickbooks/sync
VITE_API_BASE_URL=

# Must be exactly v1. Any other value disables API mode.
VITE_API_CONTRACT_VERSION=

# Analytics provider key for the provider-neutral analytics interface.
# Leave empty to log events to the console provider in development.
VITE_ANALYTICS_WRITE_KEY=

# Optional label shown in support/help copy (e.g. "production", "staging").
VITE_ENVIRONMENT_LABEL=
